<div class="section page-width">
  <div class="stack stack--lg center">
    <p class="eyebrow">{{ 'general.skip_to_content' | t }}</p>
    <h1 class="heading-section">{{ shop.name }}</h1>
    <p class="text-muted">{{ page_description | default: shop.description }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Main",
  "tag": "section",
  "class": "section-main",
  "presets": [
    {
      "name": "Main"
    }
  ]
}
{% endschema %}
